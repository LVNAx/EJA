# Project ref: xnlnzdixcwuichejzgbg (ap-northeast-1)
NEXT_PUBLIC_SUPABASE_URL=https://xnlnzdixcwuichejzgbg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternatif untuk konfigurasi lama:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wajib di produksi. Menandatangani cookie buka-kunci dasbor orang tua (minimal 16 karakter acak).
# Tanpa ini dasbor tidak akan pernah terbuka di produksi (gagal tertutup).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARENT_UNLOCK_SECRET=

# Hanya untuk email notifikasi (cron harian). Tanpa RESEND_API_KEY dan EMAIL_FROM, cron hanya dry-run.
# SERVICE ROLE MELEWATI RLS: jangan pernah diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=EJA <notifikasi@domain-anda>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
